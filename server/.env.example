# Copy to server/.env and fill in.
# MongoDB Atlas connection string. Leave unset to use the local DB from `npm run db:local`.
MONGODB_URI=mongodb://127.0.0.1:27017/hdb-resale

PORT=3000

# Python regression service (ml-service/app.py). Only needed while running `npm run fit`.
ML_SERVICE_URL=http://127.0.0.1:5001

# Optional OneMap API token (https://www.onemap.gov.sg/apidocs/register). Search works without one.
ONEMAP_TOKEN=

# Optional. Set this if MongoDB fails with "querySrv EBADRESP" (common on phone hotspots).
# DNS_SERVERS=8.8.8.8,1.1.1.1
