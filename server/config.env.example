# Copy this file to config.env (same folder) and fill it in. Never commit config.env.
# Every line is optional: anything left out uses the default written next to it.

# Your MongoDB Atlas connection string (the class calls it DB). Put the database name (check-in) before the "?".
# Leave it commented out to use a MongoDB running on your own computer.
# DB=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/check-in?retryWrites=true&w=majority

# Secret used to sign login tokens. Use any long random text (must be set when deployed).
JWT_SECRET=change-me-to-a-long-random-text

# Port for the API (default 8000, like class)
PORT=8000

# OneMap account (free, register at onemap.gov.sg). Used to get a token for place search and walking routes.
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-onemap-password
