# Copy this file to .env and fill it in. Never commit .env.

# Your MongoDB Atlas connection string. Put the database name (check-in) before the "?".
# If you leave this out, the app tries a MongoDB running on your own computer.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/check-in?retryWrites=true&w=majority

PORT=3030
