# Copy this file to .env and fill it in. Never commit .env.

# Your MongoDB Atlas connection string. Put the database name (check-in) before the "?".
# If you leave this out, the app tries a MongoDB running on your own computer.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/check-in?retryWrites=true&w=majority

# Secret used to sign login tokens. Use any long random text.
JWT_SECRET=change-me-to-a-long-random-text

PORT=3030

# OneMap account (free, register at onemap.gov.sg). Used to get a token for place search and walking routes.
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-onemap-password
