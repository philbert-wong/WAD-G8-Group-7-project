# Copy this file to .env and fill in the values. NEVER commit .env.

# MongoDB Atlas — free M0 cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hdbscope

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-something-long-and-random

# OneMap — register free at https://www.onemap.gov.sg/apidocs/register
# Required for EVERYTHING including address search (this changed - search used to be open).
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-onemap-password

# LTA DataMall — optional, only needed for MRT station data
# Register at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

PORT=3000
