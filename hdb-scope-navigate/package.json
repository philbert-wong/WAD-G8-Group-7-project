{
  "name": "hdb-scope-navigate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch server/app.js",
    "start": "node server/app.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed:sample": "node scripts/seed-sample.js",
    "seed": "node scripts/seed.js",
    "geocode": "node scripts/geocode-blocks.js",
    "walk-times": "node scripts/compute-walk-times.js",
    "seed:amenities": "node scripts/seed-amenities.js",
    "amenity-access": "node scripts/compute-amenity-access.js",
    "fit-models": "node scripts/fit-models.js",
    "seed:grants": "node scripts/seed-grants.js",
    "refresh": "node scripts/refresh.js",
    "my-work": "vitest run my-work",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "cypress run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "cypress": "^13.13.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
