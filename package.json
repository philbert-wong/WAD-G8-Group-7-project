{
  "name": "check-in",
  "private": true,
  "description": "Simple HDB resale finder: search, filters and a shortlist (Vue + Express + MongoDB)",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"pnpm --dir client dev\"",
    "format": "pnpm --dir client format",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "csv-parse": "^7.0.3"
  }
}
